# The clock. One decision, one order, per tick.
TICK_MS=300

# Seeded, so a session replays exactly. Change it to get a different market.
SEED=20260920

# The instrument. Anthropic is private: the listing and the book are both invented.
SYMBOL=ANTH
COMPANY=Anthropic
TICK_SIZE=0.01
START_PRICE=342

# How the synthetic market behaves.
# VOL_BPS is the per-tick sigma; at 1.7 a tick moves about 6 cents and a session
# ranges a few dollars. Higher is livelier and harder to quote.
VOL_BPS=1.7
DRIFT_BPS=0.5
DRIFT_FLIP_PROB=0.012
JUMP_PROB=0.0016
JUMP_BPS=15

# The book: levels generated each side, resting size at the touch.
BOOK_LEVELS=20
TOUCH_SIZE=900

# Taker flow: orders per tick, median size, and how informed that flow is.
# FLOW_LEAN is the adverse selection the desk faces, and the main dial between
# a profitable desk and a bleeding one.
FLOW_RATE=1.1
FLOW_SIZE=420
FLOW_LEAN=0.45
IMPACT_SHARES=2200

# The desk.
TRADE_SIZE=200
MAX_POSITION=1000
BANKROLL_USD=100000
QUOTE_INSIDE_TICKS=1
HORIZON_TICKS=100

# stand-in | claude. The stand-in is a local heuristic and is labelled as such
# in the dashboard. claude needs ANTHROPIC_API_KEY and skips warm-up.
MODEL=stand-in
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
INFERENCE_MS=55

PORT=3000
HISTORY_SIZE=1000
